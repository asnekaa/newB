{
  "manifest_version": 3,
  "name": "newB - 让你的Bilibili焕然一新",
  "short_name": "newB",
  "version": "0.6.0",
  "description": "优化Bilibili使用体验。",
  "default_locale": "zh_CN",
  "author": "ASneka",
  "icons": {
    "128": "assets/icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*"
  ],
  "action": {
    "default_icon": {
      "128": "assets/icon.png"
    },
    "default_title": "newB",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "css": [
        "styles/layout/global.css",
        "styles/layout/header.css",
        "styles/layout/home.css",
        "styles/layout/search.css",
        "styles/layout/video.css",
        "styles/features/hide-home-feed.css",
        "styles/features/hide-hot-search.css",
        "styles/features/hide-recommend.css",
        "styles/components/user-info-hover.css",
        "styles/components/video-info-hover.css",
        "styles/components/video-preview-player.css",
        "styles/components/dark-mode.css",
        "styles/features/easter-egg.css"
      ],
      "js": [
        "common/bili-api.js",
        "common/config-manager.js",
        "common/utils.js",
        "content/core/ui-engine.js",
        "content/core/main.js",
        "content/modules/cleanup-engine.js",
        "content/modules/cover-viewer.js",
        "content/modules/user-info-hover.js",
        "content/modules/video-info-hover.js",
        "content/modules/video-preview-player.js",
        "content/modules/easter-egg.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "inject/main-world-patch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/bililv.svg"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}
